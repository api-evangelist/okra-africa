            "body": { "mode": "raw", "raw": "{\n  \"amount\": \"\",\n  \"currency\": \"NGN\",\n  \"customer\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/pay/initiate", "host": ["{{baseUrl}}"], "path": ["pay", "initiate"] }
          }
        },
