{
  "opencollection": "1.0.0",
  "info": {
    "name": "Okra API (Historical) Accounts Balance API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check real-time balance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.okra.ng/v2/balance/check",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a live balance for a linked account."
        },
        {
          "info": {
            "name": "Refresh balance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.okra.ng/v2/balance/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Refresh balance"
        }
      ]
    }
  ],
  "bundled": true
}